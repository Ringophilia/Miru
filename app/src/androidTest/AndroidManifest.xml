<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Public synthetic read-only fixture, available only while the test APK is installed. -->
        <provider android:name="app.miru.browser.capability.SeekPreviewFixtureProvider"
            android:authorities="app.miru.browser.test.seek-preview" android:exported="true" />
        <provider android:name="app.miru.browser.PreparedFolderDocumentsProvider"
            android:authorities="app.miru.browser.test.prepared-folders" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <provider android:name="app.miru.browser.UploadTreeDocumentsProvider"
            android:authorities="app.miru.browser.test.upload-trees" android:exported="true"
            android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
        <!-- Test APK only. DocumentsUI grants the target app access after a real user selection. -->
        <provider
            android:name="app.miru.browser.UploadFixtureDocumentsProvider"
            android:authorities="app.miru.browser.test.upload-fixtures"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>
    </application>
</manifest>
