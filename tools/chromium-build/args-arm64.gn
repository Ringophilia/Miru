# Miru Phase C1 verified de-Googled Chromium 159.0.8154.33 GN arguments (ARM64 Release)
# Host: Linux x86_64 (Ubuntu 22.04/24.04 or WSL2), >= 64 GB RAM, >= 250 GB NVMe/ext4 SSD.
# Links dynamically against Miru's single shared Rust core (libmiru_core.so, DT_SONAME).
# See tools/chromium-build/README.md for //miru_engine:miru_chromium_engine_aar build & packaging.

target_os = "android"
target_cpu = "arm64"
is_debug = false
is_official_build = false
is_component_build = false
dcheck_always_on = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
optimize_for_size = true
is_cfi = false
use_thin_lto = false
enable_pdf = false
enable_print_preview = false
enable_remoting = false
safe_browsing_mode = 0
enable_reporting = false
enable_rlz = false
proprietary_codecs = true
ffmpeg_branding = "Chrome"
icu_use_data_file = true
