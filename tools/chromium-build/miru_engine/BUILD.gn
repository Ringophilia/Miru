import("//build/config/android/config.gni")
import("//build/config/android/rules.gni")
import("//third_party/jni_zero/jni_zero.gni")
import("//tools/grit/repack.gni")

repack("miru_chromium_pak") {
  sources = [
    "$root_gen_dir/content/content_resources.pak",
    "$root_gen_dir/content/gpu_resources.pak",
    "$root_gen_dir/content/service_worker_resources.pak",
    "$root_gen_dir/mojo/public/js/mojo_bindings_resources.pak",
    "$root_gen_dir/net/net_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_resources.pak",
    "$root_gen_dir/third_party/blink/public/resources/blink_scaled_resources_100_percent.pak",
    "$root_gen_dir/third_party/blink/public/strings/blink_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
  ]
  deps = [
    "//content:content_resources",
    "//content/browser/resources",
    "//mojo/public/js:resources",
    "//net:net_resources",
    "//third_party/blink/public:resources",
    "//third_party/blink/public:scaled_resources_100_percent",
    "//third_party/blink/public/strings",
    "//ui/resources",
    "//ui/strings",
  ]
  output = "$root_out_dir/miru_chromium.pak"
}

generate_jni("miru_engine_jni") {
  sources = [
    "java/src/app/miru/chromium/engine/MiruChromiumRuntime.java",
    "java/src/app/miru/chromium/engine/MiruChromiumTab.java",
  ]
}

android_library("miru_engine_java") {
  sources = [
    "java/src/app/miru/chromium/engine/MiruChromiumRuntime.java",
    "java/src/app/miru/chromium/engine/MiruChromiumTab.java",
    "java/src/app/miru/chromium/engine/MiruChromiumViewport.java",
  ]
  srcjar_deps = [ ":miru_engine_jni" ]
  deps = [
    "//base:base_java",
    "//build/android:build_java",
    "//components/embedder_support/android:content_view_java",
    "//components/embedder_support/android:view_java",
    "//content/public/android:content_java",
    "//media/base/android:media_java",
    "//media/capture/video/android:capture_java",
    "//net/android:net_java",
    "//third_party/androidx:androidx_annotation_annotation_java",
    "//third_party/androidx:androidx_core_core_java",
    "//third_party/jni_zero:jni_zero_java",
    "//ui/android:ui_java",
    "//url:gurl_java",
  ]
}

source_set("miru_engine_native") {
  sources = [
    "native/miru_browser_context.cc",
    "native/miru_browser_context.h",
    "native/miru_browser_main_parts.cc",
    "native/miru_browser_main_parts.h",
    "native/miru_content_browser_client.cc",
    "native/miru_content_browser_client.h",
    "native/miru_content_client.cc",
    "native/miru_content_client.h",
    "native/miru_descriptors.h",
    "native/miru_download_delegate.cc",
    "native/miru_download_delegate.h",
    "native/miru_https_only_throttle.cc",
    "native/miru_https_only_throttle.h",
    "native/miru_main_delegate.cc",
    "native/miru_main_delegate.h",
    "native/miru_runtime_jni.cc",
    "native/miru_tab.cc",
    "native/miru_tab.h",
    "native/miru_url_loader_factory.cc",
    "native/miru_url_loader_factory.h",
    "native/miru_url_loader_throttle.cc",
    "native/miru_url_loader_throttle.h",
  ]
  include_dirs = [
    ".",
    "prebuilt/include",
  ]
  deps = [
    ":miru_engine_jni",
    "//base",
    "//cc/base",
    "//components/crash/content/browser",
    "//components/download/public/common:public",
    "//components/embedder_support:user_agent",
    "//components/keyed_service/content",
    "//components/keyed_service/core",
    "//components/memory_system",
    "//components/performance_manager",
    "//components/viz/common",
    "//content/public/app",
    "//content/public/browser",
    "//content/public/common",
    "//content/public/gpu",
    "//content/public/renderer",
    "//content/public/utility",
    "//media",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//skia",
    "//third_party/blink/public/common",
    "//third_party/jni_zero",
    "//ui/android",
    "//ui/base",
    "//ui/gfx",
    "//url",
  ]
}

shared_library_with_jni("libmiru_chromium") {
  sources = [ "native/miru_library_loader.cc" ]
  deps = [
    ":miru_chromium_pak",
    ":miru_engine_jni",
    ":miru_engine_native",
    "//components/embedder_support/android:view",
    "//content/public/app",
    "//media",
    "//skia",
    "//third_party/jni_zero",
  ]
  ldflags = [ "-L" + rebase_path("prebuilt/$android_app_abi", root_build_dir) ]
  libs = [ "miru_core" ]
  configs -= [ "//build/config/android:hide_all_but_jni_onload" ]
  configs += [ "//build/config/android:hide_all_but_jni" ]
  add_stubs_for_missing_jni = true
  remove_uncalled_jni = true
  java_targets = [ ":miru_engine_jni_apk_stub" ]
}

android_library("miru_engine_aar_java") {
  deps = [
    ":miru_engine_java",
    "//components/embedder_support/android:content_view_java",
    "//components/embedder_support/android:view_java",
    "//components/viz/service:service_java",
    "//content/public/android:content_java",
    "//media/capture/video/android:capture_java",
    "//mojo/public/java:system_java",
    "//net/android:net_java",
    "//ui/android:ui_java",
  ]
  srcjar_deps = [ ":libmiru_chromium__jni_registration" ]
}

# Dummy APK target used solely so shared_library_with_jni computes exact JNI registration closure.
android_apk("miru_engine_jni_apk_stub") {
  apk_name = "MiruEngineStub"
  android_manifest = "android/AndroidManifest.xml"
  deps = [
    ":miru_engine_java",
    "//content/public/android:content_java",
    "//media/capture/video/android:capture_java",
    "//net/android:net_java",
    "//ui/android:ui_java",
  ]
  shared_libraries = [ ":libmiru_chromium" ]
  srcjar_deps = [ ":libmiru_chromium__jni_registration" ]
}

dist_aar("miru_chromium_engine_aar") {
  output = "$root_build_dir/miru_chromium_engine_${android_app_abi}.aar"
  deps = [
    ":libmiru_chromium",
    ":miru_chromium_pak",
    ":miru_engine_aar_java",
    "//content/public/android:content_java",
    "//gin:v8_snapshot_assets",
    "//media/capture/video/android:capture_java",
    "//net/android:net_java",
    "//third_party/icu:icu_assets",
    "//ui/android:ui_java",
  ]
  android_manifest = "android/AndroidManifest.xml"
  native_libraries = [ "$root_build_dir/libmiru_chromium.so" ]
  proguard_configs = [ "android/proguard.txt" ]
  jar_excluded_patterns = [
    "org/chromium/build/NativeLibraries*",
    "META-INF/*",
    "_COROUTINE/*",
    "DebugProbesKt.bin",
    "kotlin-tooling-metadata.json",
    "com/google/android/gms/*",
    "com/google/firebase/*",
    "com/google/android/play/*",
    "androidx/*",
    "android/support/v4/*",
    "kotlin/*",
    "kotlinx/*",
    "org/jetbrains/*",
    "org/intellij/*",
    "com/google/errorprone/*",
    "com/google/j2objc/*",
    "com/google/common/*",
    "com/google/thirdparty/*",
    "org/jspecify/*",
    "org/checkerframework/*",
    "javax/annotation/*",
  ]
}
