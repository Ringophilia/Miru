{
  "manifest_version": 2,
  "name": "Miru Bridge",
  "version": "0.3.5",
  "browser_specific_settings": { "gecko": { "id": "bridge@miru.app" } },
  "permissions": ["cookies", "tabs", "webRequest", "<all_urls>", "nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "background": { "scripts": ["media-classifier.js", "background.js"] },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["image-policy.js"], "all_frames": true, "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["media-classifier.js", "web-video-hold.js", "content.js"], "all_frames": true, "run_at": "document_idle" }
  ],
  "incognito": "spanning"
}
